<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>app.getlogos.logos</string>
    <key>CFBundleExecutable</key>
    <string>Logos</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleName</key>
    <string>Logos</string>
    <key>CFBundleDisplayName</key>
    <string>Logos</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- #80: at most one Logos instance. Two concurrent processes share the one
         ~/.logos/accounts registry, so a second instance mid-createAccount can race
         the first instance's startup GC (reapOrphans) — the fresh dir is on disk but
         its index.json write has not yet landed, so the GC sees an unregistered
         config-less orphan and reaps it out from under the creator (and concurrent
         index writes could corrupt the registry outright). Launch Services refuses the
         second launch, removing the race's precondition. Applies to double-click /
         `open`; a raw duplicate binary launch from a terminal bypasses it (dev-only). -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Che Cheng. MIT License.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- #43: opt into secure state restoration so the value-based WindowGroup (#42)
         can reopen each window on its per-window account across relaunch. macOS 14+
         does NOT restore scenes for apps without this key, which left #42's
         selection→presentedAccountID mirror inert. Whether SwiftUI actually restores
         the value-based windows still depends on the "Close windows when quitting"
         system setting + scene storage — needs a manual ⌘Q→relaunch confirmation. -->
    <key>ApplicationSupportsSecureRestorableState</key>
    <true/>
</dict>
</plist>
