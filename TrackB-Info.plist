<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- #104: Info.plist for the Track B (xcodegen) test-host build ONLY.

     The Makefile bundle path copies the sibling `Info.plist` VERBATIM into the
     installed app, so the production identity `app.getlogos.logos` lives there
     and must never change (keychain authorizations and TCC grants anchor to it,
     #101). This file exists so the xcodegen-built test host can carry its OWN
     bundle id — `CFBundleIdentifier` reads `$(PRODUCT_BUNDLE_IDENTIFIER)`,
     which `project.yml` sets to `app.getlogos.logos.testhost` — letting Track B
     launch while a production Logos is running (LaunchServices +
     `LSMultipleInstancesProhibited` block a second instance of the SAME id;
     a different id is a different app). Companion change: the hosted test host
     binds a volatile account registry (`AccountBootstrap`), so the concurrency
     this enables cannot re-create the #80 registry race.

     Keep every other key in lockstep with `Info.plist`. -->
<dict>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>Logos</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleName</key>
    <string>Logos</string>
    <key>CFBundleDisplayName</key>
    <string>Logos</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
    <!-- #80: at most one instance PER bundle id — kept for the test host too so
         xcodebuild retries can never stack two concurrent test hosts. -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Che Cheng. MIT License.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>ApplicationSupportsSecureRestorableState</key>
    <true/>
</dict>
</plist>
